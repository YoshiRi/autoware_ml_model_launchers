<?xml version="1.0"?>
<launch>
  <arg name="namespace" default="camera5" description="Deprecated alias for camera_namespace"/>
  <arg name="camera_namespace" default="$(var namespace)" description="Camera namespace under /sensing/camera"/>
  <arg name="node_namespace" default="perception/$(var camera_namespace)" description="ROS namespace for launched nodes"/>
  <arg name="use_decompress" default="true" description="use image decompress"/>
  <arg name="use_sim_time" default="true" description="use simulation clock"/>
  <arg name="build_only" default="false" description="exit after TensorRT engine is built"/>
  <arg name="enable_bytetrack" default="true" description="launch ByteTrack with YOLOX"/>
  <arg name="enable_bytetrack_visualizer" default="true" description="launch ByteTrack visualizer"/>

  <!-- Model path args -->
  <arg name="model_name" default="yolox-sPlus-T4-960x960-debris.onnx" description="YOLOX model file"/>
  <arg name="data_path" default="/opt/autoware/mlmodels" description="autoware ML model root path"/>
  <arg name="model_folder_name" default="yolox" description="YOLOX model folder name"/>
  <arg name="model_path" default="$(var data_path)/$(var model_folder_name)/$(var model_name)" description="YOLOX model path"/>
  <arg name="label_path" default="$(var data_path)/$(var model_folder_name)/label.txt" description="YOLOX label path"/>
  <arg name="semantic_segmentation_color_map_path" default="$(var data_path)/$(var model_folder_name)/semseg_color_map.csv" description="YOLOX color map path"/>

  <!-- Topic args -->
  <arg name="input/image" default="/sensing/camera/$(var camera_namespace)/image_raw"/>
  <arg name="output/objects" default="/perception/object_recognition/detection/$(var camera_namespace)/rois"/>
  <arg name="output/mask" default="/perception/object_recognition/detection/$(var camera_namespace)/mask"/>
  <arg name="output/tracked_objects" default="/perception/object_recognition/detection/$(var camera_namespace)/tracked/rois"/>

  <include file="$(find-pkg-share autoware_tensorrt_yolox)/launch/yolox.launch.xml">
    <arg name="namespace" value="$(var node_namespace)"/>
    <arg name="data_path" value="$(var data_path)"/>
    <arg name="input/image" value="$(var input/image)"/>
    <arg name="output/objects" value="$(var output/objects)"/>
    <arg name="output/mask" value="$(var output/mask)"/>
    <arg name="yolox_param_path" value="$(find-pkg-share autoware_ml_model_launchers)/config/tensorrt_yolox.param.yaml"/>
    <arg name="model_path" value="$(var model_path)"/>
    <arg name="label_path" value="$(var label_path)"/>
    <arg name="semantic_segmentation_color_map_path" value="$(var semantic_segmentation_color_map_path)"/>
    <arg name="use_decompress" value="$(var use_decompress)"/>
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
    <arg name="build_only" value="$(var build_only)"/>
  </include>

  <group if="$(var enable_bytetrack)">
    <push-ros-namespace namespace="$(var node_namespace)"/>

    <include file="$(find-pkg-share autoware_bytetrack)/launch/bytetrack.launch.xml">
      <arg name="in_image" value="$(var input/image)"/>
      <arg name="detection_rect" value="$(var output/objects)"/>
      <arg name="tracked_rect" value="$(var output/tracked_objects)"/>
      <arg name="enable_visualizer" value="$(var enable_bytetrack_visualizer)"/>
      <arg name="camera_index" value="_$(var camera_namespace)"/>
      <arg name="use_sim_time" value="$(var use_sim_time)"/>
    </include>
  </group>
</launch>
