#!/usr/bin/env bash

set -u

camera_namespace="camera5"
data_path="/opt/autoware/mlmodels"
pipeline="camera"
detector_backend="ultralytics"
errors=0
warnings=0

usage() {
  cat <<'EOF'
Usage: check_environment [--pipeline PIPELINE] [--camera CAMERA_NAMESPACE]
                         [--data-path MODEL_ROOT] [--backend DETECTOR_BACKEND]

PIPELINE is one of: camera, open_detector, open_yolo, bevfusion, ptv3,
                    centerpoint, streampetr.
DETECTOR_BACKEND is one of: ultralytics, yolo_world, dfine, rfdetr, fake.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --pipeline)
      if [[ $# -lt 2 || -z "$2" ]]; then
        printf 'Missing value for --pipeline\n' >&2
        exit 2
      fi
      pipeline="$2"
      shift 2
      ;;
    --camera)
      if [[ $# -lt 2 || -z "$2" ]]; then
        printf 'Missing value for --camera\n' >&2
        exit 2
      fi
      camera_namespace="$2"
      shift 2
      ;;
    --data-path)
      if [[ $# -lt 2 || -z "$2" ]]; then
        printf 'Missing value for --data-path\n' >&2
        exit 2
      fi
      data_path="$2"
      shift 2
      ;;
    --backend)
      if [[ $# -lt 2 || -z "$2" ]]; then
        printf 'Missing value for --backend\n' >&2
        exit 2
      fi
      detector_backend="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      printf 'Unknown argument: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

case "$pipeline" in
  camera|open_detector|open_yolo|bevfusion|ptv3|centerpoint|streampetr)
    ;;
  *)
    printf 'Unknown pipeline: %s\n' "$pipeline" >&2
    usage >&2
    exit 2
    ;;
esac

if [[ "$pipeline" == "open_yolo" ]]; then
  detector_backend="ultralytics"
fi

case "$detector_backend" in
  yolo|ultralytics_yolo)
    detector_backend="ultralytics"
    ;;
  world|yolo-world|yoloworld)
    detector_backend="yolo_world"
    ;;
  d-fine)
    detector_backend="dfine"
    ;;
  rf-detr)
    detector_backend="rfdetr"
    ;;
  ultralytics|yolo_world|dfine|rfdetr|fake)
    ;;
  *)
    printf 'Unknown detector backend: %s\n' "$detector_backend" >&2
    usage >&2
    exit 2
    ;;
esac

ok() {
  printf '[ OK ] %s\n' "$1"
}

warn() {
  printf '[WARN] %s\n' "$1"
  warnings=$((warnings + 1))
}

fail() {
  printf '[FAIL] %s\n' "$1"
  errors=$((errors + 1))
}

printf 'Autoware ML model launcher environment check\n'
printf '  pipeline:  %s\n' "$pipeline"
printf '  camera:    %s\n' "$camera_namespace"
printf '  model root: %s\n\n' "$data_path"
if [[ "$pipeline" == "open_detector" || "$pipeline" == "open_yolo" ]]; then
  printf '  detector backend: %s\n\n' "$detector_backend"
fi

if command -v ros2 >/dev/null 2>&1; then
  ok "ros2 is available"
else
  fail "ros2 is not available; source the ROS and Autoware workspaces"
fi

if command -v nvidia-smi >/dev/null 2>&1 && nvidia-smi -L >/dev/null 2>&1; then
  ok "NVIDIA GPU is available"
else
  fail "NVIDIA GPU is not available through nvidia-smi"
fi

case "$pipeline" in
  camera)
    required_packages=(
      autoware_bytetrack
      autoware_image_transport_decompressor
      autoware_tensorrt_yolox
      autoware_traffic_light_category_merger
      autoware_traffic_light_classifier
    )
    required_models=(
      "yolox/yolox-sPlus-T4-960x960-debris.onnx"
      "yolox/label.txt"
      "yolox/semseg_color_map.csv"
      "traffic_light_detector/yolox_s_car_ped_tl_detector_960_960_batch_1.onnx"
      "traffic_light_detector/car_ped_tl_detector_labels.txt"
      "traffic_light_classifier/traffic_light_classifier_mobilenetv2_batch_6.onnx"
      "traffic_light_classifier/ped_traffic_light_classifier_mobilenetv2_batch_6.onnx"
      "traffic_light_classifier/lamp_labels.txt"
      "traffic_light_classifier/lamp_labels_ped.txt"
      "traffic_light_classifier/lamp_recognizer_ml.param.yaml"
    )
    input_topics=("/sensing/camera/$camera_namespace/image_raw/compressed")
    ;;
  open_detector|open_yolo)
    required_packages=(
      autoware_ml_model_launchers
      vision_msgs
    )
    required_models=()
    input_topics=("/sensing/camera/$camera_namespace/image_raw/compressed")
    ;;
  bevfusion)
    required_packages=(autoware_bevfusion)
    required_models=(
      "bevfusion_lidar/bevfusion_lidar.onnx"
      "bevfusion_lidar/bevfusion_lidar.param.yaml"
      "bevfusion_lidar/ml_package_bevfusion_lidar.param.yaml"
      "bevfusion_lidar/detection_class_remapper.param.yaml"
    )
    input_topics=("/sensing/lidar/concatenated/pointcloud")
    ;;
  ptv3)
    required_packages=(autoware_ptv3)
    required_models=(
      "ptv3/ptv3.onnx"
      "ptv3/ml_package_ptv3.param.yaml"
    )
    input_topics=("/sensing/lidar/concatenated/pointcloud")
    ;;
  centerpoint)
    required_packages=(autoware_lidar_centerpoint)
    required_models=(
      "lidar_centerpoint/centerpoint_tiny_ml_package.param.yaml"
      "lidar_centerpoint/detection_class_remapper.param.yaml"
    )
    input_topics=("/sensing/lidar/concatenated/pointcloud")
    ;;
  streampetr)
    required_packages=(autoware_camera_streampetr)
    required_models=(
      "streampetr/simplify_extract_img_feat.onnx"
      "streampetr/simplify_pts_head_memory.onnx"
      "streampetr/simplify_position_embedding.onnx"
      "streampetr/tensorrt_stream_petr.param.yaml"
    )
    input_topics=(
      "/sensing/camera/camera8/image_raw/compressed"
      "/sensing/camera/camera8/camera_info"
      "/sensing/camera/camera6/image_raw/compressed"
      "/sensing/camera/camera6/camera_info"
      "/sensing/camera/camera10/image_raw/compressed"
      "/sensing/camera/camera10/camera_info"
      "/sensing/camera/camera7/image_raw/compressed"
      "/sensing/camera/camera7/camera_info"
      "/sensing/camera/camera9/image_raw/compressed"
      "/sensing/camera/camera9/camera_info"
    )
    ;;
esac

if command -v ros2 >/dev/null 2>&1; then
  for package in "${required_packages[@]}"; do
    if ros2 pkg prefix "$package" >/dev/null 2>&1; then
      ok "ROS package: $package"
    else
      fail "ROS package not found: $package"
    fi
  done
fi

if [[ "$pipeline" == "open_detector" || "$pipeline" == "open_yolo" ]] &&
  command -v ros2 >/dev/null 2>&1; then
  open_yolo_prefix="$(ros2 pkg prefix autoware_ml_model_launchers 2>/dev/null || true)"
  open_yolo_executable="$open_yolo_prefix/lib/autoware_ml_model_launchers/open_detector_node"
  if [[ -x "$open_yolo_executable" ]]; then
    interpreter="$(head -n 1 "$open_yolo_executable")"
    interpreter="${interpreter#\#!}"
    if [[ "$interpreter" == "/usr/bin/env python3" ]]; then
      interpreter="$(command -v python3)"
    fi
    import_check="import cv2, numpy, vision_msgs, autoware_ml_model_launchers.open_detector"
    case "$detector_backend" in
      ultralytics)
        import_check="$import_check; import ultralytics"
        ;;
      yolo_world)
        import_check="$import_check; import ultralytics, clip"
        ;;
      dfine)
        import_check="$import_check; import torch, torchvision"
        import_check="$import_check; from PIL import Image"
        import_check="$import_check; assert hasattr(Image, 'Resampling')"
        import_check="$import_check; from transformers import AutoImageProcessor, DFineForObjectDetection"
        ;;
      rfdetr)
        import_check="$import_check; import PIL, rfdetr"
        ;;
    esac
    if [[ -x "$interpreter" ]] &&
      "$interpreter" -c "$import_check" >/dev/null 2>&1; then
      ok "open detector Python environment supports backend: $detector_backend"
    else
      fail "open detector cannot import backend '$detector_backend' dependencies: $interpreter"
    fi
  else
    fail "open_yolo executable not found: $open_yolo_executable"
  fi
fi

for model in "${required_models[@]}"; do
  if [[ -r "$data_path/$model" ]]; then
    ok "model file: $model"
  else
    fail "model file missing or unreadable: $data_path/$model"
  fi
done

if command -v ros2 >/dev/null 2>&1; then
  topic_list="$(timeout 3 ros2 topic list 2>/dev/null || true)"
  for input_topic in "${input_topics[@]}"; do
    if grep -Fxq "$input_topic" <<<"$topic_list"; then
      ok "input topic is available: $input_topic"
    else
      warn "input topic is not currently available: $input_topic"
    fi
  done
  if [[ "$warnings" -ne 0 ]]; then
    printf '       Start the sensor source or play the rosbag, then check again.\n'
  fi
fi

printf '\nSummary: %d error(s), %d warning(s)\n' "$errors" "$warnings"
if [[ "$errors" -ne 0 ]]; then
  exit 1
fi
