<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>autoware_ml_model_launchers</name>
  <version>0.1.0</version>
  <description>Launchers and small helper nodes for Autoware ML model validation.</description>
  <maintainer email="yoshiri@example.com">YoshiRi</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>ament_cmake_python</build_depend>

  <exec_depend>autoware_bytetrack</exec_depend>
  <exec_depend>autoware_bevfusion</exec_depend>
  <exec_depend>autoware_camera_streampetr</exec_depend>
  <exec_depend>autoware_image_transport_decompressor</exec_depend>
  <exec_depend>autoware_lidar_centerpoint</exec_depend>
  <exec_depend>autoware_ptv3</exec_depend>
  <exec_depend>autoware_tensorrt_yolox</exec_depend>
  <exec_depend>autoware_traffic_light_category_merger</exec_depend>
  <exec_depend>autoware_traffic_light_classifier</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tier4_perception_msgs</exec_depend>
  <exec_depend>vision_msgs</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
